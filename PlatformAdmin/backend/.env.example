PORT=4000
# Dùng CÙNG MongoDB với BOBAPOS BE (DigitalOcean / local)
MONGODB_URI=mongodb://127.0.0.1:27017/exe201
# true = đọc tenants/subscriptions/users/invoices từ BOBAPOS (mặc định)
BOBAPOS_BRIDGE=true
FRONTEND_ORIGIN=http://localhost:3001
JWT_SECRET=exe201-local-dev-secret-change-before-production
PLATFORM_ADMIN_EMAIL=admin@bobapos.io
PLATFORM_ADMIN_PASSWORD=change-this-before-production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BOBAPOS Admin
# Khuyến nghị: gọi API nghiệp vụ của EXE201/BE thay vì ghi trực tiếp DB.
BOBAPOS_INTERNAL_API_URL=http://localhost:3001/api/platform-admin
BOBAPOS_INTERNAL_API_SECRET=replace-with-the-same-secret-as-exe201-be
